# Base URL of the Cognitive Firewall backend API.
# Leave unset for local development (defaults to http://localhost:5000).
# Set this to your deployed backend URL in production, e.g.:
#   REACT_APP_API_URL=https://api.your-domain.com
REACT_APP_API_URL=http://localhost:5000

# Google OAuth client ID for "Continue with Google". Leave unset to show the
# button disabled. Must match GOOGLE_CLIENT_ID on the backend.
REACT_APP_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
