# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/cognitive_firewall

# Port the API server listens on
PORT=5000

# Secret used to sign/verify JWTs. Set a long random value in production.
JWT_SECRET=change_me_to_a_long_random_string

# Allowed CORS origin(s) for the frontend (comma-separated). Defaults to
# http://localhost:3000 when unset.
CLIENT_URL=http://localhost:3000

# Optional: Twelve Data API key for the /api/market/live-price proxy
# MARKET_API_KEY=your_key_here
