# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/cognitive_firewall

# Port the API server listens on
PORT=5000

# Secret used to sign/verify JWTs. Set a long random value in production.
JWT_SECRET=change_me_to_a_long_random_string

# Allowed CORS origin(s) for the frontend (comma-separated). Defaults to
# http://localhost:3000 when unset.
CLIENT_URL=http://localhost:3000

# Google OAuth client ID for "Continue with Google" (same value as the
# frontend REACT_APP_GOOGLE_CLIENT_ID). Google sign-in is disabled when unset.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional: Twelve Data API key for the /api/market/live-price proxy
# MARKET_API_KEY=your_key_here

# Encrypts broker API credentials at rest. Any long random string; keep it stable.
# Leave unset to disable live broker connections (CSV import still works).
BROKER_ENCRYPTION_KEY=
